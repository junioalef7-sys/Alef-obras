{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alef-obras.vercel.app"
        }
      ],
      "destination": "https://alef-obras-obrix3.vercel.app/obrix.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "alef-obras.vercel.app"
        }
      ],
      "destination": "https://alef-obras-obrix3.vercel.app/:path*",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": {
      "test/obrix-legal-20261127": false
    }
  }
}
